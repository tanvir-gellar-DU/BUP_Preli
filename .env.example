# OpenRouter is not required for GET /health. It becomes mandatory for
# POST /optimize-energy once the interpretation phase is implemented.
OPENROUTER_API_KEY=
# Optional JSON key pool. Each request starts with the next key and fails over
# to another key only after HTTP 429. Never commit real values.
OPENROUTER_API_KEYS=[]
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=openai/gpt-5-nano
OPENROUTER_TIMEOUT_SECONDS=15.0
